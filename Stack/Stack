#include <stdio.h>

#define MAXSIZE 100

typedef struct 
{
	int data[MAXSIZE];
	int top;
}SeqStack;

void InitStack(SeqStack *s)
{
	s->top = -1;
}

int StackEmpty(SeqStack *s)
{
	return s->top == -1;
}

int StackFull(SeqStack *s)
{
	return s->top == MAXSIZE - 1;
}

void Stack_Push(SeqStack* s, int value)
{
	if (StackFull(s))
	{
		printf("Stack is full, cannot push %d\n", value);
		return;   
	}
	s->top++;
	s->data[s->top] = value;
	printf("Pushed %d to stack\n", value);
}

int Stack_Pop(SeqStack* s)
{
	if (StackEmpty(s))
	{
		printf("Stack is empty, cannot pop\n");
		return -1;   
	}
	int value = s->data[s->top];
	s->top--;
	printf("Popped %d from stack\n", value);
	return value;
}

// 7. 取栈顶元素（不弹出）
int Stack_GetTop(SeqStack* s)
{
	if (StackEmpty(s))
	{
		printf("Stack is empty\n");
		return -1;
	}
	return s->data[s->top];
}

// 8. 打印栈（从栈顶到栈底）
void Stack_Print(SeqStack* s)
{
	if (StackEmpty(s))
	{
		printf("Stack is empty\n");
		return;
	}
	printf("Stack elements: ");
	for (int i = s->top; i >= 0; i--)
	{
		printf("%d ", s->data[i]);
	}
	printf("\n");
}

int main()
{
	SeqStack s;
	InitStack(&s);

	printf("=== Test 1: Pop from empty stack ===\n");
	int x = Stack_Pop(&s);
	printf("Returned: %d\n\n", x);

	printf("=== Test 2: Push elements ===\n");
	Stack_Push(&s, 10);
	Stack_Push(&s, 20);
	Stack_Push(&s, 30);
	Stack_Push(&s, 40);
	Stack_Print(&s);

	printf("\n=== Test 3: Get top element ===\n");
	printf("Top element: %d\n\n", Stack_GetTop(&s));

	printf("=== Test 4: Pop twice ===\n");
	Stack_Pop(&s);
	Stack_Pop(&s);
	Stack_Print(&s);

	printf("\n=== Test 5: Push more elements ===\n");
	Stack_Push(&s, 99);
	Stack_Push(&s, 88);
	Stack_Print(&s);

	printf("\n=== Test 6: Check status ===\n");
	printf("Is empty: %s\n", StackEmpty(&s) ? "yes" : "no");
	printf("Is full: %s\n", StackFull(&s) ? "yes" : "no");

	return 0;
}

